@model TARge25shop.Models.RealEstate.RealEstateDeleteViewModel

@{
    ViewData["Title"] = "Delete Real Estate";
}

<h1>Delete Real Estate</h1>

<h3>Are you sure you want to delete this?</h3>

<hr />

<dl class="row">
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Property Type</dt>
    <dd class="col-sm-9">@Model.PropertyType</dd>

    <dt class="col-sm-3">Rooms</dt>
    <dd class="col-sm-9">@Model.Rooms</dd>

    <dt class="col-sm-3">Area</dt>
    <dd class="col-sm-9">@Model.Area m²</dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price €</dd>

    <dt class="col-sm-3">Created At</dt>
    <dd class="col-sm-9">@Model.CreatedAt</dd>

    <dt class="col-sm-3">Updated At</dt>
    <dd class="col-sm-9">@Model.UpdatedAt</dd>
</dl>

<form asp-controller="RealEstate"
      asp-action="DeleteConfirmed"
      asp-route-id="@Model.Id"
      method="post">

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="RealEstate"
           asp-action="Index"
           class="btn btn-secondary">
        Back to List
    </a>
</form>