@model IEnumerable<TARge25shop.Models.RealEstate.RealEstateIndexViewModel>

@{
    ViewData["Title"] = "Real Estate";
}

<h1>Real Estate</h1>

<p>
    <a asp-controller="RealEstate"
           asp-action="Create"
           class="btn btn-success">
        Create New
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Address</th>
            <th>Property Type</th>
            <th>Rooms</th>
            <th>Area</th>
            <th>Price</th>
            <th>Created At</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Address</td>
                <td>@item.PropertyType</td>
                <td>@item.Rooms</td>
                <td>@item.Area m²</td>
                <td>@item.Price €</td>
                <td>@item.CreatedAt</td>

                <td>
                    <a asp-controller="RealEstate"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info">
                        Details
                    </a>

                    <a asp-controller="RealEstate"
                           asp-action="Update"
                           asp-route-id="@item.Id"
                           class="btn btn-warning">
                        Update
                    </a>

                    <a asp-controller="RealEstate"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>